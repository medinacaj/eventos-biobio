# Copia este archivo como .env para personalizar. Todas las variables son opcionales.
# Puerto inicial (el launcher busca el siguiente libre si está ocupado).
PORT=8765
# Ruta de la base SQLite (por defecto data/eventos.db).
# EVENTOS_DB=data/eventos.db
# Si se define, POST /api/admin/refresh exige la cabecera X-Admin-Token con este valor.
# ADMIN_TOKEN=cambia-esto
# 1 = no imprimir cada petición HTTP en la consola.
EVENTOS_QUIET=1
